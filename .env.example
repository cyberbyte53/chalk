# Every setting that can change, in one place. Copy to .env (never committed) and fill it in.
# The server reads it at start; the app reads the ones it needs when it is built (Vite).
# On the box, the same file sits next to deploy/compose.yml.

# ---- where the app lives ----
# Development: Vite's address. On the box: https://chalk1.centralindia.cloudapp.azure.com
ORIGIN=http://localhost:5173
# The server's port (Vite passes /api on to it in development).
PORT=8080

# ---- sign-in ----
# The OAuth Web client from Google Cloud (Credentials). Not a secret: it is in the app's code.
GOOGLE_CLIENT_ID=21573012252-2r3l2abqh6g04s7mn5hsg2fnafkdgpm4.apps.googleusercontent.com
# on: also sign in as anyone with a name, without Google (development only; refused unless
# ORIGIN is localhost). The app then opens already signed in as "Tester", a learner in a dev class
# for every course (the server makes them at start); ?as=Asha&role=teacher to be someone else.
# Signing out stops that on the device until the next ?as=.
DEV_SIGN_IN=on

# ---- database ----
DATABASE_URL=postgres://chalk:chalk@localhost:5432/chalk
# On the box, the password Postgres is created with (compose.yml); DATABASE_URL uses it too.
# POSTGRES_PASSWORD=

# ---- Jugnu's model ----
# Jugnu thinks on the server (each turn on a copy of the board), so the key never reaches a phone.
# He needs a model that can call tools.
#
# openai-compatible   Any /v1/chat/completions API: DeepSeek, Microsoft Foundry, LM Studio, vLLM,
#                     and Ollama (it serves /v1 too).
# off                 No Jugnu button.
JUGNU_PROVIDER=openai-compatible
JUGNU_MODEL_SERVER=https://api.deepseek.com
# The model the server uses (required with JUGNU_MODEL_SERVER).
JUGNU_MODEL=deepseek-flash
JUGNU_API_KEY=
#
# Microsoft Foundry: the resource's endpoint without /v1, and your deployment's name as the model.
#   JUGNU_MODEL_SERVER=https://<resource>.openai.azure.com/openai
#   JUGNU_MODEL=<deployment name>
#   JUGNU_API_KEY=<key from the resource>
#
# Ollama on this computer. Use 127.0.0.1, not localhost (Node may try ::1, where Ollama doesn't listen).
#   JUGNU_MODEL_SERVER=http://127.0.0.1:11434
#   JUGNU_MODEL=qwen3.5:9b
#
# on: let the model reason silently before answering (better on hard problems, much slower).
# JUGNU_THINK=on
