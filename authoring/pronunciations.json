{
  "$comment": "How text on screen is said aloud, for every lesson. Rules run in order, group by group; $1 is what the brackets in `match` caught. A line's own `speak` always wins over these.",
  "groups": [
    {
      "name": "maths",
      "describe": "Symbols and notation read as words. Brackets before bare roots.",
      "rules": [
        {
          "match": "½",
          "en": " one half ",
          "hi": " आधा "
        },
        {
          "match": "¼",
          "en": " one quarter ",
          "hi": " एक चौथाई "
        },
        {
          "match": "√\\(([^)]+)\\)",
          "en": " square root of $1 ",
          "hi": " $1 का वर्गमूल "
        },
        {
          "match": "√\\s*([0-9]+(?:\\.[0-9]+)?|[a-zA-Z])",
          "en": " square root of $1 ",
          "hi": " $1 का वर्गमूल "
        },
        {
          "match": "∛\\s*([0-9]+(?:\\.[0-9]+)?|[a-zA-Z])",
          "en": " cube root of $1 ",
          "hi": " $1 का घनमूल "
        },
        {
          "match": "([0-9]+(?:\\.[0-9]+)?|[a-zA-Z)])²",
          "en": "$1 squared",
          "hi": "$1 का वर्ग"
        },
        {
          "match": "([0-9]+(?:\\.[0-9]+)?|[a-zA-Z)])³",
          "en": "$1 cubed",
          "hi": "$1 का घन"
        },
        {
          "match": "\\s*×\\s*",
          "en": " times ",
          "hi": " गुणा "
        },
        {
          "match": "\\s*÷\\s*",
          "en": " divided by ",
          "hi": " भाग "
        },
        {
          "match": "\\s*≈\\s*",
          "en": " is about ",
          "hi": " लगभग "
        },
        {
          "match": "\\s*≠\\s*",
          "en": " is not equal to ",
          "hi": " बराबर नहीं "
        },
        {
          "match": "\\s*≤\\s*",
          "en": " is at most ",
          "hi": " अधिकतम "
        },
        {
          "match": "\\s*≥\\s*",
          "en": " is at least ",
          "hi": " कम से कम "
        },
        {
          "match": "\\s*=\\s*",
          "en": " equals ",
          "hi": " बराबर "
        },
        {
          "match": "\\s*\\+\\s*",
          "en": " plus ",
          "hi": " जोड़ "
        },
        {
          "match": "−",
          "en": " minus ",
          "hi": " ऋण "
        },
        {
          "match": "π",
          "en": " pi ",
          "hi": " पाई "
        },
        {
          "match": "°(?![CF])",
          "en": " degrees",
          "hi": " डिग्री"
        },
        {
          "match": "([0-9]+)%",
          "en": "$1 percent",
          "hi": "$1 प्रतिशत"
        }
      ]
    },
    {
      "name": "units",
      "describe": "Units after a number.",
      "rules": [
        {
          "match": "([0-9])\\s*°C",
          "en": "$1 degrees Celsius",
          "hi": "$1 डिग्री सेल्सियस"
        },
        {
          "match": "([0-9])\\s*km/h\\b",
          "en": "$1 kilometres per hour",
          "hi": "$1 किलोमीटर प्रति घंटा"
        },
        {
          "match": "([0-9])\\s*m/s\\b",
          "en": "$1 metres per second",
          "hi": "$1 मीटर प्रति सेकंड"
        },
        {
          "match": "([0-9])\\s*km\\b",
          "en": "$1 kilometres",
          "hi": "$1 किलोमीटर"
        },
        {
          "match": "([0-9])\\s*cm\\b",
          "en": "$1 centimetres",
          "hi": "$1 सेंटीमीटर"
        },
        {
          "match": "([0-9])\\s*kg\\b",
          "en": "$1 kilograms",
          "hi": "$1 किलोग्राम"
        },
        {
          "match": "([0-9])\\s*Ω",
          "en": "$1 ohms",
          "hi": "$1 ओम"
        }
      ]
    },
    {
      "name": "chemistry",
      "describe": "Formulas: subscript digits are said as numbers after the element.",
      "rules": [
        {
          "match": "₀",
          "en": " 0 ",
          "hi": " 0 "
        },
        {
          "match": "₁",
          "en": " 1 ",
          "hi": " 1 "
        },
        {
          "match": "₂",
          "en": " 2 ",
          "hi": " 2 "
        },
        {
          "match": "₃",
          "en": " 3 ",
          "hi": " 3 "
        },
        {
          "match": "₄",
          "en": " 4 ",
          "hi": " 4 "
        },
        {
          "match": "₅",
          "en": " 5 ",
          "hi": " 5 "
        },
        {
          "match": "₆",
          "en": " 6 ",
          "hi": " 6 "
        },
        {
          "match": "₇",
          "en": " 7 ",
          "hi": " 7 "
        },
        {
          "match": "₈",
          "en": " 8 ",
          "hi": " 8 "
        },
        {
          "match": "₉",
          "en": " 9 ",
          "hi": " 9 "
        }
      ]
    },
    {
      "name": "abbreviations",
      "describe": "Short forms said in full, and letters said one by one.",
      "rules": [
        {
          "match": "\\be\\.g\\.",
          "en": "for example",
          "hi": "उदाहरण के लिए"
        },
        {
          "match": "\\bi\\.e\\.",
          "en": "that is",
          "hi": "यानी"
        },
        {
          "match": "\\bFig\\.\\s*",
          "en": "figure ",
          "hi": "चित्र "
        },
        {
          "match": "\\bNCERT\\b",
          "en": "N C E R T",
          "hi": "एन सी ई आर टी"
        },
        {
          "match": "\\bDNA\\b",
          "en": "D N A",
          "hi": "डी एन ए"
        }
      ]
    }
  ]
}
