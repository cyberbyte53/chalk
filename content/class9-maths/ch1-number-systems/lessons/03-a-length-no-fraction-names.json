            "with": {
              "prompt": {
                "en": "Is there any fraction p/q whose square is exactly 2?",
                "hi": "क्या कोई भिन्न p/q है जिसका वर्ग ठीक 2 हो?"
              },
              "options": [
                {
                  "id": "decimal",
                  "label": {
                    "en": "Yes: 1.414",
                    "hi": "हाँ: 1.414"
                  },
                  "feedback": {
                    "en": "Square 1.414. Do you get exactly 2?",
                    "hi": "1.414 का वर्ग करो। क्या ठीक 2 आता है?"
                  },
                  "misconception": "longDecimalIsExact"
                },
                {
                  "id": "close",
                  "label": {
                    "en": "Yes: 99/70",
                    "hi": "हाँ: 99/70"
                  },
                  "feedback": {
                    "en": "(99/70)² = 9801/4900 = 2.0002… How far is that from 2? Is it zero?",
                    "hi": "(99/70)² = 9801/4900 = 2.0002… यह 2 से कितना दूर है? क्या शून्य?"
                  },
                  "misconception": "veryCloseIsEqual"
                },
                {
                  "id": "no",
                  "label": {
                    "en": "No: every fraction's square misses 2",
                    "hi": "नहीं: हर भिन्न का वर्ग 2 से चूक जाता है"
                  }
                }
              ],
              "answer": "no",
              "concepts": [
                "irrational-numbers"
              ],
              "speak": {
                "en": "Is there any fraction p over q whose square is exactly 2?",
                "hi": "क्या कोई भिन्न p बटा q है जिसका वर्ग ठीक 2 हो?"
              }
            }
          },
          {
