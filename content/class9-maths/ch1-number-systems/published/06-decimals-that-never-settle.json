          },
          {
            "id": 3,
            "name": "piEquals",
            "kind": "prop",
            "prop": "choice",
            "with": {
              "prompt": {
                "en": "True or false: π = 22/7.",
                "hi": "सही या ग़लत: π = 22/7।"
              },
              "options": [
                {
                  "id": "true",
                  "label": {
                    "en": "True",
                    "hi": "सही"
                  },
                  "feedback": {
                    "en": "Watch the line as it zooms in. Do π and 22/7 land on the same point?",
                    "hi": "रेखा को पास से देखो। क्या π और 22/7 एक ही बिंदु पर हैं?"
                  },
                  "misconception": "piIsTwentyTwoSevenths"
                },
                {
                  "id": "false",
                  "label": {
                    "en": "False",
                    "hi": "ग़लत"
                  }
                }
              ],
              "answer": "false",
              "concepts": [
                "irrational-decimals"
              ],
              "speak": {
                "en": "True or false: pi equals 22 over 7.",
                "hi": "सही या ग़लत: पाई बराबर 22 बटा 7।"
              }
            }
          },
          {
            "id": 4,
            "name": "mayaApart",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "maya",
              "line": {
                "en": "π = 3.14159… is irrational; 22/7 = 3.142857… repeats. They part at the third decimal place. Archimedes and Aryabhata found such close values, but π itself is no fraction.",
                "hi": "π = 3.14159… अपरिमेय है; 22/7 = 3.142857… दोहराता है। तीसरे दशमलव स्थान पर दोनों अलग हो जाते हैं। आर्किमिडीज़ और आर्यभट ने ऐसे पास के मान निकाले, पर π ख़ुद कोई भिन्न नहीं है।"
              },
              "speak": {
                "en": "Pi, 3.14159 and so on, is irrational; 22 over 7, 3.142857, repeats. They part at the third decimal place. Archimedes and Aryabhata found such close values, but pi itself is no fraction.",
                "hi": "पाई, 3.14159 और आगे, अपरिमेय है; 22 बटा 7, 3.142857, दोहराता है। तीसरे दशमलव स्थान पर दोनों अलग हो जाते हैं। आर्किमिडीज़ और आर्यभट ने ऐसे पास के मान निकाले, पर पाई ख़ुद कोई भिन्न नहीं है।"
              }
            }
          },
          {
            "id": 5,
            "name": "rest",
            "kind": "space"
          }
