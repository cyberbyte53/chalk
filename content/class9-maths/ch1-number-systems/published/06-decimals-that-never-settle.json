          },
          {
            "id": 3,
            "name": "isItRational",
            "kind": "prop",
            "prop": "choice",
            "with": {
              "prompt": {
                "en": "Here each 1 is followed by one more 0 than the last. Is this number rational?",
                "hi": "यहाँ हर 1 के बाद पिछली बार से एक 0 ज़्यादा आता है। क्या यह संख्या परिमेय है?"
              },
              "options": [
                {
                  "id": "pattern",
                  "label": {
                    "en": "Yes: it has a pattern",
                    "hi": "हाँ: इसमें एक पैटर्न है"
                  },
                  "feedback": {
                    "en": "Repeating means the same block of digits comes again and again. Which block repeats here?",
                    "hi": "दोहराने का मतलब है अंकों का वही हिस्सा बार-बार आए। यहाँ कौन-सा हिस्सा दोहराता है?"
                  },
                  "misconception": "patternMeansRecurring"
                },
                {
                  "id": "endless",
                  "label": {
                    "en": "Yes: it goes on for ever",
                    "hi": "हाँ: यह हमेशा चलती रहती है"
                  },
                  "feedback": {
                    "en": "1/3 = 0.333… goes on for ever too. What does 1/3 have that this number doesn't?",
                    "hi": "1/3 = 0.333… भी हमेशा चलता है। 1/3 में ऐसा क्या है जो इस संख्या में नहीं?"
                  },
                  "misconception": "endlessMeansRational"
                },
                {
                  "id": "no",
                  "label": {
                    "en": "No",
                    "hi": "नहीं"
                  }
                }
              ],
              "answer": "no",
              "concepts": [
                "irrational-decimals"
              ]
            }
          },
          {
            "id": 4,
            "name": "arjunNoBlock",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "arjun",
              "line": {
                "en": "Every p/q terminates or repeats a fixed block, because its remainders run out. A decimal that does neither can't be p/q.",
                "hi": "हर p/q या तो ख़त्म होती है या एक तय हिस्सा दोहराती है, क्योंकि उसके शेषफल ख़त्म हो जाते हैं। जो दशमलव इनमें से कुछ नहीं करता, वह p/q नहीं हो सकता।"
              },
              "speak": {
                "en": "Every p over q terminates or repeats a fixed block, because its remainders run out. A decimal that does neither can't be p over q.",
                "hi": "हर p बटा q या तो ख़त्म होती है या एक तय हिस्सा दोहराती है, क्योंकि उसके शेषफल ख़त्म हो जाते हैं। जो दशमलव इनमें से कुछ नहीं करता, वह p बटा q नहीं हो सकता।"
              }
            }
          },
          {
            "id": 5,
            "name": "rest",
            "kind": "space"
          }
        ]
