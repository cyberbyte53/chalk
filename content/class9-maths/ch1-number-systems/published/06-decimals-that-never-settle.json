    {
      "id": 2,
      "name": "piAndTwentyTwoSevenths",
      "root": {
        "id": 1,
        "name": "page",
        "kind": "column",
        "children": [
          {
            "id": 2,
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 3,
              "to": 3.3,
              "marks": [
                {
                  "at": 3.14159265358979,
                  "label": "π"
                },
                {
                  "at": 3.142857142857143,
                  "label": "22/7"
                }
