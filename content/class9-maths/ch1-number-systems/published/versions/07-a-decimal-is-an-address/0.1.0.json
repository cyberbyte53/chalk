            "name": "mayaAddress",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "maya",
              "line": {
                "en": "First the box 2.6 to 2.7, then 2.66 to 2.67, and now 2.665 sits right on a tick, the one marked 5. Each zoom reads one digit: a decimal is an address on the line.",
                "hi": "पहले डिब्बा 2.6 से 2.7, फिर 2.66 से 2.67, और अब 2.665 ठीक 5 वाले निशान पर है। हर ज़ूम एक अंक पढ़ता है: दशमलव, रेखा पर एक पता है।"
              }
            }
          },
          {
            "id": 7,
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [
        {
          "set": "zoom.isEnabled",
          "to": "line.level < 3 and line.lens == null"
        }
      ],
      "when": [
        {
          "on": "board.started",
          "do": {
