            "prop": "choice",
            "with": {
              "prompt": {
                "en": "Why multiply the top AND the bottom by (√5 − √3)?",
                "hi": "ऊपर और नीचे, दोनों को (√5 − √3) से गुणा क्यों करते हैं?"
              },
              "options": [
                {
                  "id": "one",
                  "label": {
                    "en": "So the value stays the same",
                    "hi": "ताकि मान वही रहे"
                  }
                },
                {
                  "id": "bigger",
                  "label": {
                    "en": "So the number gets bigger",
                    "hi": "ताकि संख्या बड़ी हो जाए"
                  },
                  "feedback": {
                    "en": "If the value changed, would it still be the same number we started with?",
                    "hi": "अगर मान बदल जाए, तो क्या यह वही संख्या रहेगी जिससे शुरू किया था?"
                  },
                  "misconception": "rationalisingChangesValue"
                },
                {
                  "id": "topOnly",
                  "label": {
                    "en": "So the top also becomes rational",
                    "hi": "ताकि ऊपर वाला भी परिमेय हो जाए"
                  },
                  "feedback": {
                    "en": "The top is 1, already rational. If only the bottom were multiplied, would the fraction still be the same number?",
                    "hi": "ऊपर 1 है, जो पहले से परिमेय है। अगर सिर्फ़ नीचे वाले को गुणा करें, तो क्या भिन्न वही संख्या रहेगी?"
                  },
                  "misconception": "multipliesOnlyOnePart"
                }
              ],
              "answer": "one",
              "concepts": [
                "rationalising"
              ],
              "speak": {
                "en": "Why multiply the top and the bottom by root 5 minus root 3?",
                "hi": "ऊपर और नीचे, दोनों को रूट 5 माइनस रूट 3 से गुणा क्यों करते हैं?"
              }
            }
