{
  "name": "chalk",
  "private": true,
  "version": "0.0.0",
  "description": "Chalk: boards, sims and the learner app",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "editor:build": "cd platform/editor && npm run build",
    "editor:install": "cd platform/editor && npm run install-editor",
    "dev": "pnpm --parallel --filter @chalk/server --filter @chalk/learner-app --filter @chalk/studio dev",
    "mcp": "pnpm --filter @chalk/studio mcp",
    "stress-mcp": "pnpm --filter @chalk/studio stress-mcp",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm --filter @chalk/studio --silent check",
    "format": "biome check --write .",
    "preview": "pnpm --filter @chalk/studio content preview",
    "publish-content": "pnpm --filter @chalk/studio content publish",
    "build-content": "pnpm --filter @chalk/studio content build",
    "art": "pnpm --filter @chalk/studio content art",
    "ship": "sh platform/deploy/ship.sh",
    "add-school": "sh platform/deploy/add-school.sh",
    "boundaries": "pnpm --filter @chalk/studio boundaries",
    "catalogue": "pnpm --filter @chalk/studio catalogue",
    "said-compare": "pnpm --filter @chalk/studio --silent said-compare",
    "snapshot": "pnpm --filter @chalk/studio --silent snapshot",
    "sound": "pnpm --filter @chalk/studio --silent sound",
    "tool-times": "pnpm --filter @chalk/studio tool-times"
  },
  "dependencies": {
    "@chalk/author": "workspace:*",
    "@chalk/content": "workspace:*",
    "@chalk/draw": "workspace:*",
    "@chalk/exact": "workspace:*",
    "@chalk/patterns": "workspace:*",
    "@chalk/prop": "workspace:*",
    "@chalk/prop-basics": "workspace:*",
    "@chalk/prop-coordinates": "workspace:*",
    "nerdamer": "2.0.0",
    "preact": "10.29.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20",
    "pnpm": "10.28.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
