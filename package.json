{
  "name": "chalk",
  "private": true,
  "version": "0.0.0",
  "description": "Chalk: boards, sims and the learner app",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @chalk/learner-app dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "validate": "pnpm --filter @chalk/studio validate",
    "check": "pnpm typecheck && pnpm test && pnpm validate && biome check .",
    "format": "biome check --write .",
    "publish-lesson": "pnpm --filter @chalk/studio publish-lesson",
    "test-jugnu": "pnpm --filter @chalk/studio test-jugnu"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
