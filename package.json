{
  "name": "chalk",
  "private": true,
  "version": "0.0.0",
  "description": "Chalk: boards, sims and the learner app",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @chalk/server --filter @chalk/learner-app --filter @chalk/studio dev",
    "mcp": "pnpm --filter @chalk/studio mcp",
    "stress-mcp": "pnpm --filter @chalk/studio stress-mcp",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm --filter @chalk/studio --silent check",
    "format": "biome check --write .",
    "test-jugnu": "pnpm --filter @chalk/studio test-jugnu",
    "preview": "pnpm --filter @chalk/studio content preview",
    "publish-content": "pnpm --filter @chalk/studio content publish",
    "build-content": "pnpm --filter @chalk/studio content build",
    "art": "pnpm --filter @chalk/studio content art",
    "ship": "sh platform/deploy/ship.sh",
    "add-school": "sh platform/deploy/add-school.sh",
    "boundaries": "pnpm --filter @chalk/studio boundaries",
    "catalogue": "pnpm --filter @chalk/studio catalogue"
  },
  "dependencies": {
    "@chalk/author": "workspace:*",
    "@chalk/content": "workspace:*",
    "@chalk/draw": "workspace:*",
    "@chalk/exact": "workspace:*",
    "@chalk/patterns": "workspace:*",
    "@chalk/prop": "workspace:*",
    "@chalk/prop-ap": "workspace:*",
    "@chalk/prop-basics": "workspace:*",
    "@chalk/prop-carbon": "workspace:*",
    "@chalk/prop-chemistry": "workspace:*",
    "@chalk/prop-circles": "workspace:*",
    "@chalk/prop-circuit": "workspace:*",
    "@chalk/prop-control": "workspace:*",
    "@chalk/prop-coordinates": "workspace:*",
    "@chalk/prop-data": "workspace:*",
    "@chalk/prop-decimal": "workspace:*",
    "@chalk/prop-electricity": "workspace:*",
    "@chalk/prop-energy": "workspace:*",
    "@chalk/prop-environment": "workspace:*",
    "@chalk/prop-eye": "workspace:*",
    "@chalk/prop-heredity": "workspace:*",
    "@chalk/prop-life": "workspace:*",
    "@chalk/prop-light": "workspace:*",
    "@chalk/prop-linear-equations": "workspace:*",
    "@chalk/prop-magnetism": "workspace:*",
    "@chalk/prop-number-line": "workspace:*",
    "@chalk/prop-number-sets": "workspace:*",
    "@chalk/prop-periodic": "workspace:*",
    "@chalk/prop-polynomials": "workspace:*",
    "@chalk/prop-primes": "workspace:*",
    "@chalk/prop-quadratics": "workspace:*",
    "@chalk/prop-reproduction": "workspace:*",
    "@chalk/prop-resources": "workspace:*",
    "@chalk/prop-solids": "workspace:*",
    "@chalk/prop-triangles": "workspace:*",
    "@chalk/prop-trigonometry": "workspace:*",
    "nerdamer": "2.0.0",
    "preact": "10.29.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
