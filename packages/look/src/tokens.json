{
  "$description": "Chalk's look: the colours, fonts and text sizes every screen and every prop is drawn with. The one place a raw value lives. Format: W3C design tokens; a value in braces refers to another token. Run `pnpm --filter @chalk/look generate` after a change.",
  "color": {
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "The page and the board."
    },
    "surface-container": {
      "$type": "color",
      "$value": "#f5f6f8",
      "$description": "A box on the page: a definition, a prop's frame, a speech bubble."
    },
    "surface-press": {
      "$type": "color",
      "$value": "#e6e7ec",
      "$description": "The ledge under a raised card or button: it sinks onto it when pressed."
    },
    "on-surface": {
      "$type": "color",
      "$value": "#1e2130",
      "$description": "Text and the lines a prop is drawn with."
    },
    "on-surface-variant": {
      "$type": "color",
      "$value": "#6b7080",
      "$description": "Quieter text: notes, labels, what is switched off."
    },
    "outline-variant": {
      "$type": "color",
      "$value": "#e6e7ec",
      "$description": "Hairlines and borders; an empty track."
    },
    "inverse-surface": {
      "$type": "color",
      "$value": "#1e2130",
      "$description": "A dark button or chip on the light page."
    },
    "on-inverse-surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text on the inverse surface."
    },
    "primary": {
      "$type": "color",
      "$value": "#3f3bd9",
      "$description": "The thing to act on or look at: a selection, a marker, the learner's own move."
    },
    "on-primary": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text on primary."
    },
    "primary-container": {
      "$type": "color",
      "$value": "#ecebfc",
      "$description": "A light wash of primary behind something selected."
    },
    "primary-press": {
      "$type": "color",
      "$value": "#2b28a6",
      "$description": "The ledge under a primary button."
    },
    "secondary": {
      "$type": "color",
      "$value": "#f4a300",
      "$description": "The second voice: what the lesson points out next to the learner's own work."
    },
    "secondary-container": {
      "$type": "color",
      "$value": "#fff4dc",
      "$description": "A light wash of secondary."
    },
    "on-secondary-container": {
      "$type": "color",
      "$value": "#9a5200",
      "$description": "Secondary dark enough for text and thin lines."
    },
    "right": {
      "$type": "color",
      "$value": "#15803d",
      "$description": "A right answer."
    },
    "right-container": {
      "$type": "color",
      "$value": "#e7f6ec",
      "$description": "Behind a right answer."
    },
    "wrong": {
      "$type": "color",
      "$value": "#b42318",
      "$description": "A wrong answer, a problem."
    },
    "wrong-container": {
      "$type": "color",
      "$value": "#fdecea",
      "$description": "Behind a wrong answer."
    },
    "category-1": {
      "$type": "color",
      "$value": "{color.secondary}",
      "$description": "Kinds told apart by colour (tiles, groups), in this order."
    },
    "category-2": {
      "$type": "color",
      "$value": "{color.primary}"
    },
    "category-3": {
      "$type": "color",
      "$value": "#7c5cc4"
    },
    "category-4": {
      "$type": "color",
      "$value": "#2f9e8f"
    }
  },
  "brand": {
    "jugnu": {
      "$type": "color",
      "$value": "#ffd84d",
      "$description": "Jugnu's light. His own colours: never a prop's or content's."
    },
    "jugnu-glow": {
      "$type": "color",
      "$value": "#ffc400",
      "$description": "The glow around Jugnu and around what he points at."
    },
    "jugnu-container": {
      "$type": "color",
      "$value": "#fff6d6",
      "$description": "Behind Jugnu's words."
    },
    "jugnu-body": {
      "$type": "color",
      "$value": "#fbfbf8",
      "$description": "Jugnu's body."
    },
    "jugnu-curl": {
      "$type": "color",
      "$value": "#f4a300",
      "$description": "Jugnu's curl and cheeks."
    }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": ["Baloo 2", "Noto Sans Devanagari", "system-ui", "sans-serif"],
      "$description": "Everything that is read. Baloo 2 covers Latin and Devanagari."
    },
    "display": {
      "$type": "fontFamily",
      "$value": ["Baloo 2", "Noto Sans Devanagari", "system-ui", "sans-serif"],
      "$description": "Titles and numbers that stand alone."
    }
  },
  "text": {
    "title": {
      "$type": "dimension",
      "$value": "27px"
    },
    "title-leading": {
      "$type": "number",
      "$value": 1.15
    },
    "body": {
      "$type": "dimension",
      "$value": "17px"
    },
    "body-leading": {
      "$type": "number",
      "$value": 1.45
    },
    "note": {
      "$type": "dimension",
      "$value": "15px"
    },
    "note-leading": {
      "$type": "number",
      "$value": 1.4
    },
    "caption": {
      "$type": "dimension",
      "$value": "13px"
    },
    "caption-leading": {
      "$type": "number",
      "$value": 1.35
    }
  },
  "shape": {
    "radius-s": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Chips, small buttons."
    },
    "radius-m": {
      "$type": "dimension",
      "$value": "18px",
      "$description": "Buttons, options, cards."
    },
    "radius-l": {
      "$type": "dimension",
      "$value": "22px",
      "$description": "Big cards, boxes of explanation."
    },
    "press": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "How far a raised thing stands above its ledge."
    },
    "stroke": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "The main line a prop is drawn with (a number line, an axis)."
    },
    "stroke-thin": {
