{
  "name": "@chalk/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../../.env --tsconfig ../../../tsconfig.base.json src/main.ts",
    "start": "tsx --tsconfig ../../../tsconfig.base.json src/main.ts",
    "add-school": "tsx --env-file-if-exists=../../../.env --tsconfig ../../../tsconfig.base.json src/cli.ts add-school",
    "flags": "tsx --env-file-if-exists=../../../.env --tsconfig ../../../tsconfig.base.json src/cli.ts flags",
    "rebuild-facts": "tsx --env-file-if-exists=../../../.env --tsconfig ../../../tsconfig.base.json src/cli.ts rebuild-facts",
    "migration": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo"
  },
  "dependencies": {
    "@chalk/api": "workspace:*",
    "@chalk/author": "workspace:*",
    "@chalk/content": "workspace:*",
    "@chalk/content-source": "workspace:*",
    "@chalk/library": "workspace:*",
    "@chalk/player": "workspace:*",
    "@hono/node-server": "2.1.3",
    "drizzle-orm": "0.45.3",
    "google-auth-library": "11.1.0",
    "hono": "4.13.12",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.10.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
