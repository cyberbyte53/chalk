{
  "name": "chalk-editor",
  "displayName": "Chalk",
  "description": "See Chalk content as boards beside its code: the book, chapter and lesson screens, every board as a phone draws it, pick a piece to ask the agent or leave a comment.",
  "version": "0.6.17",
  "publisher": "chalk",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./out/loader.js",
  "activationEvents": ["workspaceContains:content/build.yaml"],
  "contributes": {
    "commands": [
      {
        "command": "chalk.preview",
        "title": "Chalk: Preview boards",
        "icon": "$(open-preview)"
      },
      {
        "command": "chalk.pick",
        "title": "Chalk: Pick a piece on the preview",
        "icon": "$(inspect)"
      },
      {
        "command": "chalk.refresh",
        "title": "Chalk: Refresh tree",
        "icon": "$(refresh)"
      },
      {
        "command": "chalk.thread.open",
        "title": "Open on the open threads' page"
      },
      {
        "command": "chalk.thread.source",
        "title": "Open source line",
        "icon": "$(go-to-file)"
      },
      {
        "command": "chalk.thread.reply",
        "title": "Reply",
        "icon": "$(reply)"
      },
      {
        "command": "chalk.thread.close",
        "title": "Close",
        "icon": "$(check)"
      },
      {
        "command": "chalk.thread.withdraw",
        "title": "Withdraw",
        "icon": "$(circle-slash)"
      },
      {
        "command": "chalk.thread.answer",
        "title": "Answer with this option"
      },
      {
        "command": "chalk.threads.closeReady",
        "title": "Close all ready",
        "icon": "$(check-all)"
      },
      {
        "command": "chalk.activity",
        "title": "Chalk: Show activity",
        "icon": "$(history)"
      },
      {
        "command": "chalk.thread.board",
        "title": "Open board",
        "icon": "$(link-external)"
      },
      {
        "command": "chalk.threads.open",
        "title": "Open threads",
        "icon": "$(preview)"
      },
      {
        "command": "chalk.planning.approve",
        "title": "Chalk: Approve this planning file",
        "icon": "$(pass)"
      },
      {
        "command": "chalk.planning.takeBack",
        "title": "Chalk: Take back the approval",
        "icon": "$(discard)"
      },
      {
        "command": "chalk.addSource",
        "title": "Chalk: Add a chapter's source",
        "icon": "$(new-file)"
      },
      {
        "command": "chalk.fileComment.reply",
        "title": "Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "chalk.fileComment.close",
        "title": "Close",
        "icon": "$(check)"
      },
      {
        "command": "chalk.chapter.closeReady",
        "title": "Close all ready",
        "icon": "$(check-all)"
      }
    ],
    "configuration": {
      "title": "Chalk",
      "properties": {
        "chalk.previewUrl": {
          "type": "string",
          "default": "http://localhost:5173/",
          "description": "The learner app's dev server. Started by the extension when nothing answers there."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "chalk.tree",
          "name": "Chalk"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "chalk.preview",
          "when": "resourcePath =~ /[\\\\/]content([\\\\/]|$)/",
          "group": "navigation"
        },
        {
          "command": "chalk.planning.approve",
          "when": "resourcePath =~ /[\\\\/]authoring[\\\\/]books[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+[\\\\/](brief|objectives|flow|props)\\.md$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "chalk.preview",
          "when": "resourcePath =~ /[\\\\/]content([\\\\/]|$)/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "chalk.refresh",
          "when": "view == chalk.tree",
          "group": "navigation"
        },
        {
          "command": "chalk.activity",
          "when": "view == chalk.tree",
          "group": "navigation"
        },
        {
          "command": "chalk.addSource",
          "when": "view == chalk.tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "chalk.thread.close",
          "when": "view == chalk.tree && viewItem =~ /^thread-(open|planned|ready)$/",
          "group": "inline@1"
        },
        {
          "command": "chalk.thread.reply",
          "when": "view == chalk.tree && viewItem =~ /^thread-/",
          "group": "inline@2"
        },
        {
          "command": "chalk.thread.reply",
          "when": "view == chalk.tree && viewItem =~ /^thread-/",
          "group": "1_thread@1"
        },
        {
          "command": "chalk.thread.close",
          "when": "view == chalk.tree && viewItem =~ /^thread-(open|planned|ready)$/",
          "group": "1_thread@2"
        },
        {
          "command": "chalk.thread.withdraw",
          "when": "view == chalk.tree && viewItem =~ /^thread-(open|planned|ready)$/",
          "group": "1_thread@3"
        },
        {
          "command": "chalk.thread.source",
          "when": "view == chalk.tree && viewItem =~ /^thread-/",
          "group": "2_open@1"
        },
        {
          "command": "chalk.thread.open",
          "when": "view == chalk.tree && viewItem =~ /^thread-/",
          "group": "2_open@2"
        },
        {
          "command": "chalk.threads.closeReady",
          "when": "view == chalk.tree && viewItem == yours-ready",
          "group": "inline@1"
        },
        {
          "command": "chalk.threads.closeReady",
          "when": "view == chalk.tree && viewItem == yours-ready",
          "group": "1_threads@1"
        },
        {
          "command": "chalk.thread.board",
          "when": "view == chalk.tree && viewItem =~ /^thread-/",
          "group": "2_open@3"
        },
        {
          "command": "chalk.planning.approve",
          "when": "view == chalk.tree && viewItem =~ /^planfile-(draft|changed)-approvable$/",
          "group": "inline@1"
        },
        {
          "command": "chalk.planning.takeBack",
          "when": "view == chalk.tree && viewItem == planfile-approved-approvable",
          "group": "inline@1"
        },
        {
          "command": "chalk.chapter.closeReady",
          "when": "view == chalk.tree && viewItem == chapter-ready",
          "group": "inline@1"
        },
        {
          "command": "chalk.chapter.closeReady",
          "when": "view == chalk.tree && viewItem == chapter-ready",
          "group": "1_chapter@1"
        }
      ],
      "commandPalette": [
        {
          "command": "chalk.thread.open",
          "when": "false"
        },
        {
          "command": "chalk.thread.source",
          "when": "false"
        },
        {
          "command": "chalk.thread.reply",
          "when": "false"
        },
        {
          "command": "chalk.thread.close",
          "when": "false"
        },
        {
          "command": "chalk.thread.withdraw",
          "when": "false"
        },
        {
          "command": "chalk.threads.closeReady",
          "when": "false"
        },
        {
          "command": "chalk.thread.board",
          "when": "false"
        },
        {
          "command": "chalk.threads.open",
          "when": "false"
        },
        {
          "command": "chalk.fileComment.reply",
          "when": "false"
        },
        {
          "command": "chalk.fileComment.close",
          "when": "false"
        },
        {
          "command": "chalk.thread.answer",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "chalk.planning.approve",
          "when": "resourcePath =~ /[\\\\/]authoring[\\\\/]books[\\\\/][^\\\\/]+[\\\\/][^\\\\/]+[\\\\/](brief|objectives|flow|props)\\.md$/",
          "group": "chalk@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "chalk.fileComment.reply",
          "group": "inline",
          "when": "commentController == chalk"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "chalk.fileComment.close",
          "group": "inline",
          "when": "commentController == chalk && commentThread =~ /^chalk-/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "chalk.preview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "workbench.action.addComment",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/",
        "when": "editorTextFocus && resourcePath =~ /[\\\\/]authoring[\\\\/]books[\\\\/]/"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "install-editor": "npm version patch --no-git-tag-version && npx biome format --write package.json && npm run package && cursor --install-extension chalk-editor.vsix --force",
    "package": "tsc -p tsconfig.json && npx -y @vscode/vsce@3.6.0 package --no-dependencies --allow-missing-repository --skip-license -o chalk-editor.vsix"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.90.0",
    "typescript": "5.6.3"
  }
}
