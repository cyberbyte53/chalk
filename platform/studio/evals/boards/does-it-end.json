{
  "id": "class9-maths/ch1/does-it-end",
  "version": "0.1.0",
  "title": {
    "en": "Does the decimal ever end?",
    "hi": "क्या दशमलव कभी ख़त्म होता है?"
  },
  "concepts": ["decimal-expansions"],
  "boards": [
    {
      "name": "oneEighth",
      "root": {
        "name": "page",
        "kind": "column",
        "children": [
          {
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "title",
              "text": {
                "en": "Divide 1 by 8, one step at a time. Tap the division to take the next step.",
                "hi": "1 को 8 से भाग दो, एक-एक कदम। अगले कदम के लिए भाग पर टैप करो।"
              }
            }
          },
          {
            "name": "division",
            "kind": "prop",
            "prop": "decimalExpansion",
            "with": {
              "numerator": 1,
              "denominator": 8
            }
          },
          {
            "name": "mayaEnds",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "maya",
              "line": {
                "en": "It ended: the remainder became 0, so there is nothing left to divide. 1 ÷ 8 = 0.125.",
                "hi": "यह ख़त्म हो गया: शेषफल 0 हो गया, अब भाग देने को कुछ नहीं बचा। 1 ÷ 8 = 0.125।"
              }
            }
          },
          {
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [],
      "when": [
        {
          "on": "board.started",
          "do": {
            "call": "title.say"
          }
        },
        {
          "on": "division.ended",
          "do": [
            {
              "call": "board.show",
              "args": {
                "name": "mayaEnds"
              }
            },
            {
              "call": "mayaEnds.say"
            },
            {
              "call": "board.pass"
            }
          ]
        }
      ]
    },
    {
      "name": "oneSeventh",
      "root": {
        "name": "page",
        "kind": "column",
        "children": [
          {
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "title",
              "text": {
                "en": "Now 1 ÷ 7. Keep tapping, and watch the remainders.",
                "hi": "अब 1 ÷ 7। टैप करते रहो, और शेषफलों पर नज़र रखो।"
              }
            }
          },
          {
            "name": "division",
            "kind": "prop",
            "prop": "decimalExpansion",
            "with": {
              "numerator": 1,
              "denominator": 7
            }
          },
          {
            "name": "arjunRepeats",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "arjun",
              "line": {
                "en": "Remainder 1 came back! From here the same steps happen again, so 142857 repeats for ever: 0.142857142857…",
                "hi": "शेषफल 1 वापस आ गया! यहाँ से वही कदम फिर होंगे, इसलिए 142857 हमेशा दोहराता रहेगा: 0.142857142857…"
              }
            }
          },
          {
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [],
      "when": [
        {
          "on": "board.started",
          "do": {
            "call": "title.say"
          }
        },
        {
          "on": "division.repeated",
          "do": [
            {
              "call": "board.show",
              "args": {
                "name": "arjunRepeats"
              }
            },
            {
              "call": "arjunRepeats.say"
            },
            {
              "call": "board.pass"
            }
          ]
        }
      ]
    },
    {
      "name": "twentyTwoSevenths",
      "root": {
        "name": "page",
        "kind": "column",
        "children": [
          {
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "title",
              "text": {
                "en": "22 ÷ 7 is close to π. Does its decimal end, or repeat?",
                "hi": "22 ÷ 7, π के पास है। इसका दशमलव ख़त्म होता है या दोहराता है?"
              }
            }
          },
          {
            "name": "division",
            "kind": "prop",
            "prop": "decimalExpansion",
            "with": {
              "numerator": 22,
              "denominator": 7
            }
          },
          {
            "name": "controls",
            "kind": "row",
            "children": [
              {
                "name": "divide",
                "kind": "prop",
                "prop": "button",
                "with": {
                  "label": {
                    "en": "Divide for me",
                    "hi": "मेरे लिए भाग दो"
                  }
                }
              }
            ]
          },
          {
            "name": "clock",
            "kind": "prop",
            "prop": "timer"
          },
          {
            "name": "mayaPi",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "maya",
              "line": {
                "en": "It repeats, like every fraction that doesn't end. π never repeats and never ends, so 22 ÷ 7 can only ever be close to π.",
                "hi": "यह दोहराता है, हर उस भिन्न की तरह जो ख़त्म नहीं होती। π न कभी दोहराता है, न ख़त्म होता है, इसलिए 22 ÷ 7 बस π के पास ही हो सकता है।"
              }
            }
          },
          {
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [
        {
          "set": "divide.isEnabled",
          "to": "not clock.isRunning and not division.hasRepeated"
        }
      ],
      "when": [
        {
          "on": "board.started",
          "do": {
            "call": "title.say"
          }
        },
        {
          "on": "divide.pressed",
          "do": {
            "call": "clock.start",
            "args": {
              "every": 0.5
            }
          }
        },
        {
          "on": "clock.tick",
          "do": {
            "call": "division.nextDigit"
          }
        },
        {
          "on": "division.repeated",
          "do": [
            {
              "call": "clock.stop"
            },
            {
              "call": "board.show",
              "args": {
                "name": "mayaPi"
              }
            },
            {
              "call": "mayaPi.say"
            },
            {
              "call": "board.pass"
            }
          ]
        }
      ]
    },
    {
      "name": "which",
      "root": {
        "name": "page",
        "kind": "column",
        "children": [
          {
            "name": "whichEnds",
            "kind": "prop",
            "prop": "choice",
            "with": {
              "prompt": {
                "en": "Which of these has a decimal that ends?",
                "hi": "इनमें से किसका दशमलव ख़त्म होता है?"
              },
              "options": [
                {
                  "id": "oneThird",
                  "label": {
                    "en": "1 ÷ 3",
                    "hi": "1 ÷ 3"
                  },
                  "feedback": {
                    "en": "1 ÷ 3 leaves remainder 1 at every step: 0.333… never ends.",
                    "hi": "1 ÷ 3 में हर कदम पर शेषफल 1 बचता है: 0.333… कभी ख़त्म नहीं होता।"
                  },
                  "misconception": "smallDenominatorEnds"
                },
                {
                  "id": "threeEighths",
                  "label": {
                    "en": "3 ÷ 8",
                    "hi": "3 ÷ 8"
                  }
                },
                {
                  "id": "twoSevenths",
                  "label": {
                    "en": "2 ÷ 7",
                    "hi": "2 ÷ 7"
                  },
                  "feedback": {
                    "en": "Dividing by 7, a remainder always comes back, like 1 ÷ 7 did. It repeats.",
                    "hi": "7 से भाग देने पर कोई शेषफल वापस आ ही जाता है, जैसे 1 ÷ 7 में। यह दोहराता है।"
                  },
                  "misconception": "sevenEnds"
                }
              ],
              "answer": "threeEighths",
              "concepts": ["decimal-expansions"]
            }
          },
          {
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [],
      "when": [
        {
          "on": "board.started",
          "do": {
            "call": "whichEnds.say"
          }
        },
        {
          "on": "whichEnds.correct",
          "do": {
            "call": "board.pass"
          }
        }
      ]
    }
  ]
}
