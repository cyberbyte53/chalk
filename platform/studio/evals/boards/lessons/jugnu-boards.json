        },
        {
          "set": "tossOnce.isEnabled",
          "to": "not clock.isRunning"
        },
        {
          "set": "tossMany.isEnabled",
          "to": "not clock.isRunning"
        }
      ],
      "when": [
        {
          "on": "board.started",
          "do": [
            {
              "call": "title.say"
            },
            {
              "call": "afterMany.say"
            }
          ]
        },
        {
          "on": "tossOnce.pressed",
          "do": {
            "call": "coin.toss"
          }
        },
        {
          "on": "tossMany.pressed",
          "do": {
            "call": "clock.start",
            "args": {
              "every": 0.04,
              "times": 100
            }
          }
        },
        {
          "on": "clock.tick",
          "do": {
            "call": "coin.toss"
          }
        },
        {
          "on": "coin.landed",
          "do": {
            "call": "chart.addPoint",
            "args": {
              "x": {
                "expr": "coin.count"
              },
              "y": {
                "expr": "coin.headsFraction"
              }
            }
          }
        },
        {
          "on": "afterMany.correct",
          "do": {
            "call": "board.pass"
          }
        }
      ],
      "studentOnly": []
    }
  ]
}
