{
  "id": "evals/jugnu-demos",
  "version": "0.0.0",
  "title": {
    "en": "Jugnu demo boards",
    "hi": "जुगनू के डेमो बोर्ड"
  },
  "concepts": [
    "sqrt-estimation",
    "decimal-places",
    "fractions-on-line"
  ],
  "boards": [
    {
      "id": 1,
      "name": "rootThree",
      "root": {
        "id": 1,
        "name": "page",
        "kind": "column",
        "children": [
          {
            "id": 2,
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "title",
              "text": {
                "en": "Find √3: drag the dot until its square is close to 3.",
                "hi": "√3 ढूँढो: बिंदु को तब तक खींचो जब तक उसका वर्ग 3 के पास न हो।"
              }
            }
          },
          {
            "id": 3,
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 1,
              "to": 2,
              "marker": 1.5,
              "showMarker": true,
              "isZoomable": true
            }
          },
          {
            "id": 4,
            "name": "squareLabel",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "note",
              "text": {
                "en": "…",
                "hi": "…"
              }
            }
          },
          {
            "id": 5,
            "name": "guessRoot",
            "kind": "prop",
            "prop": "goal",
            "with": {
              "prompt": {
                "en": "Press Check when the square is close to 3.",
                "hi": "जब वर्ग 3 के पास हो, तब 'जाँचो' दबाओ।"
              },
              "about": "line",
              "concepts": [
                "sqrt-estimation"
              ]
            }
          },
          {
            "id": 6,
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [
        {
          "set": "squareLabel.text",
          "text": {
            "en": "{fixed(line.marker, 2)} × {fixed(line.marker, 2)} = {fixed(line.marker * line.marker, 4)}",
            "hi": "{fixed(line.marker, 2)} × {fixed(line.marker, 2)} = {fixed(line.marker * line.marker, 4)}"
          }
        },
        {
          "set": "guessRoot.isMet",
          "to": "2.98 <= line.marker * line.marker and line.marker * line.marker <= 3.02"
        }
      ],
      "when": [
        {
          "on": "board.started",
          "do": [
            {
              "call": "title.say"
            },
            {
              "call": "guessRoot.say"
            }
          ]
        },
        {
          "on": "guessRoot.correct",
          "do": {
            "call": "board.pass"
          }
        }
      ],
      "studentOnly": [],
      "jugnu": {
        "purpose": "Estimate √3 by squeezing: square a guess, see if it is above or below 3, and move toward 3. Marks on the line and zooming in can show the squeeze.",
        "props": {
          "line": "the student's guess for √3 (the marker); marks, dots and zoom are free to use",
          "squareLabel": "the guess squared, live",
          "guessRoot": "is the guess's square close enough to 3?"
        }
      },
      "nextPieceId": 7
    },
    {
      "id": 2,
      "name": "findPi",
      "root": {
        "id": 1,
        "name": "page",
        "kind": "column",
        "children": [
          {
            "id": 2,
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "title",
              "text": {
                "en": "π is marked on the line. Zoom in to find where it is.",
                "hi": "रेखा पर π लगा है। ज़ूम करके देखो वह कहाँ है।"
              }
            }
          },
          {
            "id": 3,
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 3,
              "to": 4,
              "marker": 3.5,
              "showMarker": false,
              "isZoomable": true,
              "marks": [
                {
                  "at": 3.14159,
                  "label": "π"
                }
              ]
            }
          },
          {
            "id": 4,
            "name": "whichHundredths",
            "kind": "prop",
            "prop": "choice",
            "with": {
              "prompt": {
                "en": "Between which two hundredths is π?",
                "hi": "π किन दो सौवें भागों के बीच है?"
              },
              "options": [
                {
                  "id": "a",
                  "label": {
                    "en": "3.13 and 3.14",
                    "hi": "3.13 और 3.14"
                  }
                },
                {
                  "id": "b",
                  "label": {
                    "en": "3.14 and 3.15",
                    "hi": "3.14 और 3.15"
                  }
                },
                {
                  "id": "c",
                  "label": {
                    "en": "3.15 and 3.16",
                    "hi": "3.15 और 3.16"
                  }
                },
                {
                  "id": "d",
                  "label": {
                    "en": "3.1 and 3.2",
                    "hi": "3.1 और 3.2"
                  }
                }
              ],
              "answer": "b",
              "concepts": [
                "decimal-places"
              ]
            }
          },
          {
            "id": 5,
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [],
      "when": [
        {
          "on": "board.started",
          "do": [
            {
              "call": "title.say"
            },
            {
              "call": "whichHundredths.say"
            }
          ]
        },
        {
          "on": "whichHundredths.correct",
          "do": {
            "call": "board.pass"
          }
        }
      ],
      "studentOnly": [],
      "jugnu": {
        "purpose": "Successive magnification: each zoom into the tenth that holds π decides one more decimal place. The question asks for the hundredths, so two zooms show the answer; one zoom only shows the tenths.",
        "props": {
          "line": "a number line from 3 to 4 with π marked; magnify zooms ten times into the tenth that holds a number",
          "whichHundredths": "the question: which two hundredths π lies between"
        }
      },
      "nextPieceId": 6
    },
    {
      "id": 3,
      "name": "whereTwoThirds",
      "root": {
        "id": 1,
        "name": "page",
        "kind": "column",
        "children": [
          {
            "id": 2,
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "title",
              "text": {
                "en": "Put the dot at 2/3.",
                "hi": "बिंदु को 2/3 पर रखो।"
              },
              "speak": {
                "en": "Put the dot at two thirds.",
                "hi": "बिंदु को दो तिहाई पर रखो।"
              }
            }
          },
          {
            "id": 3,
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 0,
              "to": 1,
              "marker": 0.5,
              "showMarker": true,
              "isSplittable": true
            }
          },
          {
            "id": 4,
            "name": "atTwoThirds",
            "kind": "prop",
            "prop": "goal",
            "with": {
              "prompt": {
                "en": "Press Check when the dot is at 2/3.",
                "hi": "जब बिंदु 2/3 पर हो, तब 'जाँचो' दबाओ।"
              },
              "about": "line",
              "concepts": [
                "fractions-on-line"
              ],
              "speak": {
                "en": "Press Check when the dot is at two thirds.",
                "hi": "जब बिंदु दो तिहाई पर हो, तब जाँचो दबाओ।"
              }
            }
          },
          {
            "id": 5,
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [
        {
          "set": "atTwoThirds.isMet",
          "to": "abs(line.marker - 2 / 3) <= 0.01"
        }
      ],
      "when": [
        {
          "on": "board.started",
          "do": [
            {
              "call": "title.say"
            },
            {
              "call": "atTwoThirds.say"
            }
          ]
        },
        {
          "on": "atTwoThirds.correct",
          "do": {
            "call": "board.pass"
          }
        }
      ],
      "studentOnly": [],
      "jugnu": {
        "purpose": "A fraction is a place on the line: cut 0 to 1 into as many equal parts as the denominator, then count the numerator's parts.",
        "props": {
          "line": "0 to 1, with the student's dot; it can be cut into equal parts (split)",
          "atTwoThirds": "is the dot at 2/3?"
        }
      },
      "nextPieceId": 6
    }
  ],
  "nextBoardId": 4
}
