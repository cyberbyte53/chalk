{
  "id": "class9-maths/ch1/numbers-between",
  "version": "0.1.0",
  "title": {
    "en": "Is there always another number between?",
    "hi": "क्या बीच में हमेशा एक और संख्या होती है?"
  },
  "concepts": ["rationals-between", "density-of-rationals"],
  "boards": [
    {
      "id": 1,
      "name": "tenths",
      "root": {
        "id": 1,
        "name": "page",
        "kind": "column",
        "children": [
          {
            "id": 2,
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "title",
              "text": {
                "en": "Between 1 and 2 there are 1.1, 1.2, … 1.9. Is that all?",
                "hi": "1 और 2 के बीच 1.1, 1.2, … 1.9 हैं। क्या बस इतने ही?"
              }
            }
          },
          {
            "id": 3,
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 1,
              "to": 2,
              "marker": 1.45,
              "showMarker": false
            }
          },
          {
            "id": 4,
            "name": "arjunZoom",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "arjun",
              "line": {
                "en": "Look between 1.4 and 1.5. There's 1.41, 1.42, 1.43… a whole new row of numbers.",
                "hi": "1.4 और 1.5 के बीच देखो। 1.41, 1.42, 1.43… संख्याओं की पूरी नई कतार।"
              }
            }
          },
          {
            "id": 5,
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [],
      "when": [
        {
          "on": "board.started",
          "do": [
            {
              "call": "title.say"
            },
            {
              "wait": 0.5
            },
            {
              "par": [
                {
                  "call": "line.zoomTo",
                  "args": {
                    "from": 1.4,
                    "to": 1.5,
                    "over": 2.5
                  }
                },
                {
                  "seq": [
                    {
                      "call": "board.show",
                      "args": {
                        "name": "arjunZoom"
                      }
                    },
                    {
                      "call": "arjunZoom.say"
                    }
                  ]
                }
              ]
            },
            {
              "call": "board.pass"
            }
          ]
        }
      ],
      "nextPieceId": 6
    },
    {
      "id": 2,
      "name": "findOne",
      "root": {
        "id": 1,
        "name": "page",
        "kind": "column",
        "children": [
          {
            "id": 2,
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "title",
              "text": {
                "en": "Your turn: find a number between 1.4 and 1.5.",
                "hi": "तुम्हारी बारी: 1.4 और 1.5 के बीच की एक संख्या खोजो।"
              }
            }
          },
          {
            "id": 3,
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 1.3,
              "to": 1.6,
              "marker": 1.35
            }
          },
          {
            "id": 4,
            "name": "where",
            "kind": "prop",
            "prop": "text",
            "with": {
              "style": "note",
              "text": {
                "en": "…",
                "hi": "…"
              }
            }
          },
          {
            "id": 5,
            "name": "findOne",
            "kind": "prop",
            "prop": "goal",
            "with": {
              "prompt": {
                "en": "Drag the dot between 1.4 and 1.5, then press Check.",
                "hi": "बिंदु को 1.4 और 1.5 के बीच खींचो, फिर 'जाँचो' दबाओ।"
              },
              "about": "line",
              "concepts": ["rationals-between"]
            }
          },
          {
            "id": 6,
            "name": "mayaOne",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "maya",
              "line": {
                "en": "Yes! And there are many more: 1.42, 1.45, 1.47… any of them would do.",
                "hi": "हाँ! और भी बहुत हैं: 1.42, 1.45, 1.47… इनमें से कोई भी चलेगा।"
              }
            }
          },
          {
            "id": 7,
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [
        {
          "set": "where.text",
          "text": {
            "en": "The dot is at {fixed(line.marker, 2)}",
            "hi": "बिंदु {fixed(line.marker, 2)} पर है"
          }
        },
        {
          "set": "findOne.isMet",
          "to": "1.4 < line.marker and line.marker < 1.5"
        }
      ],
      "when": [
        {
          "on": "board.started",
          "do": {
            "call": "title.say"
          }
        },
        {
          "on": "findOne.wrong",
          "if": "line.marker <= 1.4",
          "do": {
            "call": "findOne.giveFeedback",
            "args": {
              "text": {
                "en": "That's not more than 1.4. Move right.",
                "hi": "यह 1.4 से ज़्यादा नहीं है। दाईं ओर ले जाओ।"
              }
            }
          }
        },
        {
          "on": "findOne.wrong",
          "if": "line.marker >= 1.5",
          "do": {
            "call": "findOne.giveFeedback",
            "args": {
              "text": {
                "en": "That's not less than 1.5. Move left.",
                "hi": "यह 1.5 से कम नहीं है। बाईं ओर ले जाओ।"
              }
            }
          }
        },
        {
          "on": "findOne.correct",
          "do": [
            {
              "call": "board.show",
              "args": {
                "name": "mayaOne"
              }
            },
            {
              "call": "mayaOne.say"
            },
            {
              "call": "board.pass"
            }
          ]
        }
      ],
      "nextPieceId": 8
    },
