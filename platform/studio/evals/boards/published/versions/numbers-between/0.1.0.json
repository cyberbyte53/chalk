    {
      "id": 4,
      "name": "howMany",
      "root": {
        "id": 1,
        "name": "page",
        "kind": "column",
        "children": [
          {
            "id": 2,
            "name": "howManyBetween",
            "kind": "prop",
            "prop": "choice",
            "with": {
              "prompt": {
                "en": "How many rational numbers are there between 1 and 2?",
                "hi": "1 और 2 के बीच कितनी परिमेय संख्याएँ हैं?"
              },
              "options": [
                {
                  "id": "nine",
                  "label": {
                    "en": "9: 1.1 to 1.9",
                    "hi": "9: 1.1 से 1.9 तक"
                  },
                  "feedback": {
                    "en": "Those are only the tenths. Between 1.4 and 1.5 you found more.",
                    "hi": "ये तो बस दसवें भाग हैं। 1.4 और 1.5 के बीच तुमने और खोजीं।"
                  },
                  "misconception": "onlyTenthsBetween"
                },
                {
                  "id": "hundred",
                  "label": {
                    "en": "about 100",
                    "hi": "लगभग 100"
                  },
                  "feedback": {
                    "en": "You found one between 1.41 and 1.42, and you could keep zooming. Can it ever stop?",
                    "hi": "तुमने 1.41 और 1.42 के बीच भी एक खोजी, और ज़ूम करते ही जा सकते हो। क्या यह कभी रुकेगा?"
                  },
                  "misconception": "finitelyManyBetween"
                },
                {
                  "id": "infinitelyMany",
                  "label": {
                    "en": "infinitely many",
                    "hi": "अनगिनत"
                  }
                }
              ],
              "answer": "infinitelyMany",
              "concepts": ["density-of-rationals"]
            }
          },
          {
            "id": 3,
            "name": "rest",
            "kind": "space"
          }
