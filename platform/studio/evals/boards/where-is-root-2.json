{
  "id": "class9-maths/ch1/where-is-root-2",
  "version": "0.2.0",
  "title": {
    "en": "Where does √2 live?",
    "hi": "√2 कहाँ रहता है?"
  },
  "concepts": ["sqrt-estimation", "irrational-numbers"],
  "boards": [
    {
      "name": "between",
      "root": {
        "name": "page",
        "kind": "column",
        "children": [
          {
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "text": {
                "en": "Where does √2 live?",
                "hi": "√2 कहाँ रहता है?"
              },
              "style": "title"
            }
          },
          {
            "name": "mayaSquares",
            "kind": "prop",
            "prop": "line",
            "with": {
              "character": "maya",
              "line": {
                "en": "1 × 1 = 1, and 2 × 2 = 4.",
                "hi": "1 × 1 = 1, और 2 × 2 = 4।"
              },
              "speak": {
                "en": "One times one is one, and two times two is four.",
                "hi": "एक गुणा एक, एक। और दो गुणा दो, चार।"
              }
            }
          },
          {
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 0,
              "to": 4,
              "marker": 1.5,
              "showMarker": false
            }
          },
          {
            "name": "arjunBetween",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "arjun",
              "line": {
                "en": "So the number whose square is 2 must sit between 1 and 2.",
                "hi": "तो जिस संख्या का वर्ग 2 है, वह 1 और 2 के बीच होगी।"
              }
            }
          },
          {
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [],
      "when": [
        {
          "on": "board.started",
          "do": [
            {
              "call": "board.pass"
            },
            {
              "call": "title.say"
            },
            {
              "call": "mayaSquares.say"
            },
            {
              "wait": 0.8
            },
            {
              "call": "board.show",
              "args": {
                "name": "arjunBetween"
              }
            },
            {
              "par": [
                {
                  "call": "arjunBetween.say"
                },
                {
                  "call": "line.zoomTo",
                  "args": {
                    "from": 1,
                    "to": 2,
                    "over": 2.5
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "guess",
      "root": {
        "name": "page",
        "kind": "column",
        "children": [
          {
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "text": {
                "en": "Drag the dot to where you think √2 is.",
                "hi": "बिंदु को वहाँ खींचो जहाँ तुम्हें लगता है √2 है।"
              },
              "style": "title"
            }
          },
          {
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 1,
              "to": 2,
              "marker": 1.5,
              "showMarker": true
            }
          },
          {
            "name": "squareLabel",
            "kind": "prop",
            "prop": "text",
            "with": {
              "text": {
                "en": "1.50 × 1.50 = 2.2500",
                "hi": "1.50 × 1.50 = 2.2500"
              },
              "style": "note"
            }
          },
          {
            "name": "guessRoot",
            "kind": "prop",
            "prop": "goal",
            "with": {
              "prompt": {
                "en": "Press Check when the square is close to 2.",
                "hi": "जब वर्ग 2 के पास हो, तब 'जाँचो' दबाओ।"
              },
              "about": "line",
              "concepts": ["sqrt-estimation"]
            }
          },
          {
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [
        {
          "set": "squareLabel.text",
          "text": {
            "en": "{fixed(line.marker, 2)} × {fixed(line.marker, 2)} = {fixed(line.marker * line.marker, 4)}",
            "hi": "{fixed(line.marker, 2)} × {fixed(line.marker, 2)} = {fixed(line.marker * line.marker, 4)}"
          }
        },
        {
          "set": "guessRoot.isMet",
          "to": "1.98 <= line.marker * line.marker and line.marker * line.marker <= 2.02"
        }
      ],
      "when": [
        {
          "on": "board.started",
          "do": [
            {
              "call": "title.say"
            },
            {
              "call": "guessRoot.say"
            }
          ]
        },
        {
          "on": "guessRoot.wrong",
          "if": "line.marker * line.marker < 1.98",
          "do": {
            "call": "guessRoot.giveFeedback",
            "args": {
              "text": {
                "en": "Its square is less than 2. Move right.",
                "hi": "इसका वर्ग 2 से कम है। दाईं ओर खिसकाओ।"
              }
            }
          }
        },
        {
          "on": "guessRoot.wrong",
          "if": "line.marker * line.marker > 2.02",
          "do": {
            "call": "guessRoot.giveFeedback",
            "args": {
              "text": {
                "en": "Its square is more than 2. Move left.",
                "hi": "इसका वर्ग 2 से ज़्यादा है। बाईं ओर खिसकाओ।"
              }
            }
          }
        },
        {
          "on": "guessRoot.correct",
          "do": {
            "call": "board.pass"
          }
        }
      ],
      "jugnu": {
        "purpose": "Estimate √2 by squeezing: square a guess, and move it toward where the square is 2.",
        "props": {
          "line": "the student's guess for √2 (the marker)",
          "squareLabel": "their guess squared, live",
          "guessRoot": "is the guess's square close enough to 2?"
        }
      }
    },
    {
      "name": "zoom",
      "root": {
        "name": "page",
        "kind": "column",
        "children": [
          {
            "name": "title",
            "kind": "prop",
            "prop": "text",
            "with": {
              "text": {
                "en": "Let's zoom in.",
                "hi": "चलो, पास से देखें।"
              },
              "style": "title"
            }
          },
          {
            "name": "line",
            "kind": "prop",
            "prop": "numberLine",
            "with": {
              "from": 1,
              "to": 2,
              "marker": 1.414,
              "showMarker": false
            }
          },
          {
            "name": "mayaTenths",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "maya",
              "line": {
                "en": "1.4² = 1.96 and 1.5² = 2.25. So √2 is between 1.4 and 1.5.",
                "hi": "1.4² = 1.96 और 1.5² = 2.25। तो √2, 1.4 और 1.5 के बीच है।"
              },
              "speak": {
                "en": "One point four squared is one point nine six, and one point five squared is two point two five. So root two is between one point four and one point five.",
                "hi": "एक दशमलव चार का वर्ग, एक दशमलव नौ छह। एक दशमलव पाँच का वर्ग, दो दशमलव दो पाँच। तो वर्गमूल दो, इन दोनों के बीच है।"
              }
            }
          },
          {
            "name": "arjunHundredths",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "arjun",
              "line": {
                "en": "Zoom again: 1.41² = 1.9881 and 1.42² = 2.0164.",
                "hi": "फिर से पास: 1.41² = 1.9881 और 1.42² = 2.0164।"
              }
            }
          },
          {
            "name": "mayaNeverEnds",
            "kind": "prop",
            "isHidden": true,
            "prop": "line",
            "with": {
              "character": "maya",
              "line": {
                "en": "Every zoom finds another digit, and it never stops. No decimal squares to exactly 2.",
                "hi": "हर बार एक और अंक मिलता है, और यह कभी नहीं रुकता। कोई भी दशमलव संख्या का वर्ग ठीक 2 नहीं होता।"
              }
            }
          },
          {
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [],
      "when": [
        {
          "on": "board.started",
          "do": [
            {
              "call": "board.pass"
            },
            {
              "call": "title.say"
            },
            {
              "wait": 0.5
            },
            {
              "call": "board.show",
              "args": {
                "name": "mayaTenths"
              }
            },
            {
              "par": [
                {
                  "call": "mayaTenths.say"
                },
                {
                  "call": "line.zoomTo",
                  "args": {
                    "from": 1.4,
                    "to": 1.5,
                    "over": 3
                  }
                }
              ]
            },
            {
              "wait": 0.6
            },
            {
              "call": "board.show",
              "args": {
                "name": "arjunHundredths"
              }
            },
            {
              "par": [
                {
                  "call": "arjunHundredths.say"
                },
                {
                  "call": "line.zoomTo",
                  "args": {
                    "from": 1.41,
                    "to": 1.42,
                    "over": 3
                  }
                }
              ]
            },
            {
              "wait": 0.6
            },
            {
              "call": "line.placeMark",
              "args": {
                "at": 1.41421356,
                "label": "√2"
              }
            },
            {
              "call": "board.show",
              "args": {
                "name": "mayaNeverEnds"
              }
            },
            {
              "call": "mayaNeverEnds.say"
            }
          ]
        }
      ]
    },
    {
      "name": "check",
      "root": {
        "name": "page",
        "kind": "column",
        "children": [
          {
            "name": "whatIsRoot2",
            "kind": "prop",
            "prop": "choice",
            "with": {
              "prompt": {
                "en": "Which is true about √2?",
                "hi": "√2 के बारे में कौन-सी बात सही है?"
              },
              "options": [
                {
                  "id": "exactly-1-41",
                  "label": {
                    "en": "√2 = 1.41 exactly",
                    "hi": "√2 ठीक 1.41 है"
                  },
                  "feedback": {
                    "en": "1.41 × 1.41 = 1.9881, not 2. Close, but not exact.",
                    "hi": "1.41 × 1.41 = 1.9881, 2 नहीं। पास है, पर ठीक नहीं।"
                  },
                  "misconception": "rootIsFiniteDecimal"
                },
                {
                  "id": "never-ends",
                  "label": {
                    "en": "Its decimal goes on forever without repeating",
                    "hi": "इसका दशमलव बिना दोहराए हमेशा चलता रहता है"
                  }
                },
                {
                  "id": "not-on-line",
                  "label": {
                    "en": "√2 is not a point on the number line",
                    "hi": "√2 संख्या रेखा पर कोई बिंदु नहीं है"
                  },
                  "feedback": {
                    "en": "It is! We just zoomed in on exactly where it sits.",
                    "hi": "है! हमने अभी पास से देखा कि यह ठीक कहाँ है।"
                  },
                  "misconception": "irrationalNotOnLine"
                }
              ],
              "answer": "never-ends",
              "concepts": ["irrational-numbers"]
            }
          },
          {
            "name": "rest",
            "kind": "space"
          }
        ]
      },
      "is": [],
      "when": [
        {
          "on": "board.started",
          "do": {
            "call": "whatIsRoot2.say"
          }
        },
        {
          "on": "whatIsRoot2.correct",
          "do": {
            "call": "board.pass"
          }
        }
      ]
    }
  ]
}
