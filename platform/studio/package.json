{
  "name": "@chalk/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "content": "tsx --tsconfig ../../tsconfig.base.json --import ./src/content/record-imports.ts src/content/cli.ts",
    "boundaries": "tsx --tsconfig ../../tsconfig.base.json src/boundaries-cli.ts",
    "catalogue": "tsx --tsconfig ../../tsconfig.base.json src/catalogue-cli.ts",
    "sound": "tsx --tsconfig ../../tsconfig.base.json src/sound/cli.ts",
    "check": "tsx --tsconfig ../../tsconfig.base.json src/check/all.ts",
    "mcp": "node start.mjs",
    "stress-mcp": "tsx --tsconfig ../../tsconfig.base.json src/mcp/stress.ts",
    "bench-look": "tsx --tsconfig ../../tsconfig.base.json src/mcp/bench-look.ts",
    "dev": "node start.mjs",
    "tool-times": "tsx --tsconfig ../../tsconfig.base.json src/mcp/tool-times.ts",
    "brand-icons": "tsx --tsconfig ../../tsconfig.base.json scripts/brand-icons.ts",
    "label-compare": "tsx --tsconfig ../../tsconfig.base.json scripts/label-compare.ts"
  },
  "dependencies": {
    "@chalk/author": "workspace:*",
    "@chalk/content": "workspace:*",
    "@chalk/content-source": "workspace:*",
    "@chalk/library": "workspace:*",
    "@chalk/player": "workspace:*",
    "@chalk/prop": "workspace:*",
    "@chalk/sounds": "workspace:*",
    "@jridgewell/trace-mapping": "0.3.31",
    "@modelcontextprotocol/sdk": "1.32.1",
    "katex": "0.16.22",
    "pixelmatch": "5.3.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "preact": "10.29.8",
    "preact-render-to-string": "6.5.13",
    "speech-rule-engine": "4.1.5",
    "typescript": "5.6.3",
    "yaml": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@chalk/exact": "workspace:*",
    "@types/node": "22.10.2",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.15"
  }
}
