{
  "name": "@chalk/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "validate": "tsx --tsconfig ../../tsconfig.base.json src/cli.ts ../../content",
    "publish-lesson": "tsx --tsconfig ../../tsconfig.base.json src/publish-cli.ts",
    "test-jugnu": "tsx --tsconfig ../../tsconfig.base.json src/jugnu-eval/cli.ts",
    "content": "tsx --tsconfig ../../tsconfig.base.json --import ./src/content/record-imports.ts src/content/cli.ts",
    "cache-check": "tsx --tsconfig ../../tsconfig.base.json src/jugnu-eval/cache-check.ts",
    "trace": "tsx --tsconfig ../../tsconfig.base.json src/jugnu-eval/trace.ts",
    "chat-log": "tsx --tsconfig ../../tsconfig.base.json src/jugnu-eval/chat-log.ts",
    "boundaries": "tsx --tsconfig ../../tsconfig.base.json src/boundaries-cli.ts",
    "catalogue": "tsx --tsconfig ../../tsconfig.base.json src/catalogue-cli.ts",
    "check": "tsx --tsconfig ../../tsconfig.base.json src/check/all.ts"
  },
  "dependencies": {
    "@chalk/author": "workspace:*",
    "@chalk/content": "workspace:*",
    "@chalk/jugnu": "workspace:*",
    "@chalk/library": "workspace:*",
    "@chalk/player": "workspace:*",
    "@chalk/prop": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.63.0",
    "preact": "10.29.8",
    "preact-render-to-string": "6.5.13",
    "yaml": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@chalk/exact": "workspace:*",
    "@types/node": "22.10.2",
    "tsx": "4.23.15"
  }
}
